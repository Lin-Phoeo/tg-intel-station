# ---------- 依赖 ----------
node_modules/
app/web/node_modules/

# ---------- 构建产物 ----------
app/web/dist/

# ---------- 抓取数据（体积大，用 scrape/scrape.mjs 重新生成）----------
data/*
!data/stats.json

# ---------- 检索索引（约 1.5GB，用 app/server/build-db.mjs 重建）----------
app/data/*.db
app/data/*.db-wal
app/data/*.db-shm

# ---------- 本机 AI 配置（含 API Key，绝不能提交）----------
app/data/settings.json

# ---------- 生成的大体积导出 ----------
output/数据/
output/index.html
output/预览图-仪表盘.png

# ---------- 临时文件 ----------
*.log
*.tmp
app/_*.png
.DS_Store
Thumbs.db
